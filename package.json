{
  "name": "evetools",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "check": "pnpm check:ui-parity && turbo lint test build typecheck",
    "check:ui-parity": "node scripts/check-ui-parity.mjs",
    "dev:chat": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo dev --filter=@evetools/chat",
    "dev:chat-mobile": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo start --filter=@evetools/chat-mobile",
    "dev:draw": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo dev --filter=@evetools/draw",
    "dev:draw-desktop": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo dev --filter=@evetools/draw-desktop",
    "dev:code": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo dev --filter=@evetools/code",
    "dev:code-desktop": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo dev --filter=@evetools/code-desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5"
  }
}
