{
  "name": "@evetools/code-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The terminal interface for Evecode",
  "bin": {
    "evecode": "./bin/evecode.mjs",
    "eve-agent": "./bin/evecode.mjs"
  },
  "files": [
    "agent",
    "bin",
    "docs",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
