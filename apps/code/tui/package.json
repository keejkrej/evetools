    "check": "pnpm typecheck && pnpm test && pnpm build",
    "agent": "node ./bin/evecode.mjs",
    "info": "eve info"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.31",
    "ai": "^7.0.65",
    "tsx": "^4.23.9",
