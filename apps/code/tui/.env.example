# Required by both Evecode launch surfaces. Never commit a real key.
OPENAI_BASE_URL=https://subproxy.example/v1
OPENAI_API_KEY=sk-sub-...

# Normally selected by the `evecode` launcher.
# EVECODE_WORKSPACE_ROOT=/absolute/path/to/a/repository

# Application data defaults to ~/.evecode.
# EVECODE_DATA_ROOT=/absolute/path/to/evecode-data
