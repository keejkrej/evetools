# Shared identity and provider credentials
EVE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Required by Next.js browser bundles during dev/build.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
EVE_OWNER_USER_ID=user_...
OPENROUTER_API_KEY=

# Optional default for both `evecode launch web` and `evecode launch tui`.
# A positional workspace argument takes precedence.
# EVECODE_WORKSPACE_ROOT=C:\absolute\path\to\a\local\project
# Evecode CLI model settings live below this root.
# EVECODE_DATA_ROOT=C:\absolute\path\to\evecode-data
